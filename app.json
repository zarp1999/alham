{
  "expo": {
    "name": "Alham",
    "slug": "habit-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zarp1.kotsukotsu"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zarp1.kotsukotsu"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      "expo-router",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TodayHabits",
              "displayName": "今日の習慣 / Өнөөдрийн дадлууд",
              "description": "今日の習慣を確認",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "src/widgets/TodayHabits.ios.tsx"
              },
              "android": null
            }
          ]
        }
      ],
      "./plugins/with-short-cmake-paths"
    ],
    "scheme": "kotsukotsu"
  }
}
